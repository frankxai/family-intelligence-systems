{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-intelligence.systems/schemas/consent-withdrawal.v1.json",
  "title": "Consent Withdrawal Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "withdrawal_id",
    "family_id",
    "consent_id",
    "requested_by_person_id",
    "authority_basis",
    "requested_at",
    "verification_status",
    "execution_status",
    "inventory_status",
    "requested_actions"
  ],
  "properties": {
    "withdrawal_id": { "type": "string", "pattern": "^withdrawal_[A-Za-z0-9_-]+$" },
    "family_id": { "type": "string", "minLength": 1 },
    "consent_id": { "type": "string", "pattern": "^consent_[A-Za-z0-9_-]+$" },
    "requested_by_person_id": { "type": "string", "minLength": 1 },
    "authority_basis": { "enum": ["self", "parental_responsibility", "legal_guardian", "authorized_representative"] },
    "requested_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "verification_status": { "enum": ["pending", "verified", "rejected", "review_required"] },
    "execution_status": { "enum": ["not_started", "in_progress", "executed", "partially_executed", "not_applicable"] },
    "inventory_status": { "enum": ["not_started", "in_progress", "complete", "no_artifacts_found", "review_required"] },
    "inventory_summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "artifact_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_ref", "artifact_kind", "disposition"],
        "properties": {
          "artifact_ref": { "type": "string", "minLength": 1 },
          "artifact_kind": { "enum": ["consent_receipt", "evidence", "derived_artifact", "public_page", "search_index", "export", "external_copy", "other"] },
          "disposition": { "enum": ["not_found", "suppressed", "deleted", "retained_minimum_metadata", "recipient_controlled", "review_required"] },
          "notes": { "type": "string", "maxLength": 800 }
        }
      }
    },
    "effective_at": { "type": "string", "format": "date-time" },
    "requested_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["collect", "store", "transcribe", "summarize", "share", "publish", "ai_process", "export"] }
    },
    "affected_artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "residual_retention": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_ref", "reason", "review_required"],
        "properties": {
          "artifact_ref": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 800 },
          "review_required": { "type": "boolean" }
        }
      }
    },
    "unresolved_artifact_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "execution_notes": { "type": "string", "maxLength": 2000 },
    "executed_at": { "type": "string", "format": "date-time" },
    "consent_state_after": { "enum": ["withdrawn", "superseded", "review_required"] },
    "replacement_consent_id": { "type": "string", "pattern": "^consent_[A-Za-z0-9_-]+$" },
    "reviewer_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "verification_status": { "const": "verified" } }, "required": ["verification_status"] },
      "then": { "required": ["verified_at"] }
    },
    {
      "if": { "properties": { "execution_status": { "enum": ["executed", "partially_executed"] } }, "required": ["execution_status"] },
      "then": {
        "required": ["effective_at", "executed_at", "verified_at", "inventory_summary", "artifact_inventory", "consent_state_after"],
        "properties": {
          "verification_status": { "const": "verified" },
          "inventory_status": { "enum": ["complete", "no_artifacts_found"] },
          "consent_state_after": { "enum": ["withdrawn", "superseded"] }
        }
      }
    },
    {
      "if": { "properties": { "execution_status": { "const": "partially_executed" } }, "required": ["execution_status"] },
      "then": { "required": ["unresolved_artifact_refs"] }
    },
    {
      "if": { "properties": { "consent_state_after": { "const": "superseded" } }, "required": ["consent_state_after"] },
      "then": { "required": ["replacement_consent_id"] }
    }
  ]
}
