{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-intelligence.systems/schemas/export-manifest.v1.json",
  "title": "Family Export Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_id",
    "family_id",
    "created_by_person_id",
    "created_at",
    "format_version",
    "scope",
    "encryption",
    "files",
    "excluded_categories",
    "restore_test_required"
  ],
  "properties": {
    "export_id": { "type": "string", "pattern": "^export_[A-Za-z0-9_-]+$" },
    "family_id": { "type": "string", "minLength": 1 },
    "created_by_person_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "format_version": { "const": "1.0" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["self", "household", "core_circle", "extended_family", "descendants_guardianship", "trusted_advisors", "public_archive"] }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "algorithm", "key_delivery"],
      "properties": {
        "required": { "const": true },
        "algorithm": { "type": "string", "minLength": 1 },
        "key_delivery": { "enum": ["separate_verified_channel", "recipient_public_key"] }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "excluded_categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "restore_test_required": { "const": true },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
