{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-intelligence.systems/schemas/federated-contribution-envelope.v1.json",
  "title": "Private Federated Family Contribution Envelope",
  "$comment": "Shape validation is not transfer authorization. Embedded receipt fields are non-authoritative; approved or transferred states require server-side @family/security resolution under protocols/trusted-transition-admission/v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_id", "sender_tenant_ref", "recipient_tenant_ref", "purpose", "scope", "expires_at", "bilateral_approval_refs", "authority_check_refs", "payload_manifest_ref", "recipient_capability_ref", "withdrawal_callback_ref", "status"],
  "properties": {
    "envelope_id": { "type": "string", "pattern": "^federation_[A-Za-z0-9_-]+$" },
    "sender_tenant_ref": { "type": "string", "pattern": "^tenant_[A-Za-z0-9_-]+$" },
    "recipient_tenant_ref": { "type": "string", "pattern": "^tenant_[A-Za-z0-9_-]+$" },
    "purpose": { "type": "string", "minLength": 5, "maxLength": 500 },
    "scope": { "enum": ["candidate_claims", "approved_public_descriptions", "source_catalogue_metadata"] },
    "expires_at": { "type": "string", "format": "date-time" },
    "bilateral_approval_refs": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^human_decision_[A-Za-z0-9_-]+$" } },
    "authority_check_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^authority_check_[A-Za-z0-9_-]+$" } },
    "payload_manifest_ref": { "type": "string", "pattern": "^manifest_[A-Za-z0-9_-]+$" },
    "recipient_capability_ref": { "type": "string", "pattern": "^capability_receipt_[A-Za-z0-9_-]+$" },
    "withdrawal_callback_ref": { "type": "string", "pattern": "^withdrawal_route_[A-Za-z0-9_-]+$" },
    "recipient_receipt_ref": { "type": "string", "pattern": "^recipient_receipt_[A-Za-z0-9_-]+$" },
    "semantic_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "evaluated_at", "distinct_tenants_verified", "expiry_current", "bilateral_humans_verified", "authority_checks_verified", "recipient_capability_verified"],
      "properties": {
        "receipt_ref": { "type": "string", "pattern": "^runtime_validation_[A-Za-z0-9_-]+$" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "distinct_tenants_verified": { "const": true },
        "expiry_current": { "const": true },
        "bilateral_humans_verified": { "const": true },
        "authority_checks_verified": { "const": true },
        "recipient_capability_verified": { "const": true }
      }
    },
    "status": { "enum": ["draft", "human_review_required", "approved_for_transfer", "transferred", "received_quarantined", "withdrawn", "expired", "blocked"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["approved_for_transfer", "transferred", "received_quarantined"] } }, "required": ["status"] },
      "then": { "required": ["semantic_validation"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["transferred", "received_quarantined"] } }, "required": ["status"] },
      "then": { "required": ["recipient_receipt_ref"] }
    }
  ]
}
