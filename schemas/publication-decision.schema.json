{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-intelligence.systems/schemas/publication-decision.v1.json",
  "title": "Publication Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "family_id",
    "artifact_ref",
    "claim_refs",
    "living_persons_affected",
    "consent_receipts",
    "rights_review",
    "redactions",
    "reviewers",
    "decision",
    "decided_at"
  ],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^publication_[A-Za-z0-9_-]+$" },
    "family_id": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "claim_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "living_persons_affected": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "consent_receipts": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rights_review": { "enum": ["cleared", "not_required", "blocked", "needs_review"] },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string" }
        }
      }
    },
    "reviewers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "decision": { "enum": ["blocked", "changes_required", "approved_private", "approved_public", "withdrawn"] },
    "public_path": { "type": "string", "pattern": "^/" },
    "rollback_ref": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" }
  }
}
