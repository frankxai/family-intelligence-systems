{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-intelligence.systems/schemas/claim.v1.json",
  "title": "Family Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "family_id",
    "claimant_id",
    "subject",
    "predicate",
    "object",
    "evidence_refs",
    "source_grade",
    "extracted_by",
    "confidence",
    "status",
    "privacy_scope",
    "living_persons_affected",
    "consent_receipts",
    "reviewers",
    "disputes",
    "publication_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "claim_id": { "type": "string", "pattern": "^claim_[A-Za-z0-9_-]+$" },
    "family_id": { "type": "string", "minLength": 1 },
    "claimant_id": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "#/$defs/entityRef" },
    "predicate": { "type": "string", "minLength": 1, "maxLength": 120 },
    "object": {
      "oneOf": [
        { "$ref": "#/$defs/entityRef" },
        { "type": "string", "minLength": 1, "maxLength": 2000 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "time_range": { "$ref": "#/$defs/timeRange" },
    "place": { "$ref": "#/$defs/place" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "source_grade": { "enum": ["A", "B", "C", "D", "unknown"] },
    "extracted_by": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "enum": [
        "received",
        "quarantined",
        "normalized",
        "possible_duplicate",
        "evidence_reviewed",
        "consent_reviewed",
        "steward_reviewed",
        "accepted",
        "disputed",
        "rejected",
        "unresolved",
        "privately_available",
        "publication_review",
        "publicly_published"
      ]
    },
    "privacy_scope": { "$ref": "#/$defs/privacyScope" },
    "living_persons_affected": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "consent_receipts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "disputes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "supersedes": { "type": "string", "minLength": 1 },
    "publication_status": { "enum": ["not_requested", "blocked", "pending_review", "approved", "published", "withdrawn"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "entityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["person", "event", "place", "organization", "artifact", "relationship"] },
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "maxLength": 240 }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "precision": { "enum": ["exact", "day", "month", "year", "decade", "approximate", "unknown"] }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original": { "type": "string", "maxLength": 500 },
        "normalized": { "type": "string", "maxLength": 500 },
        "place_id": { "type": "string" }
      }
    },
    "privacyScope": {
      "enum": ["self", "household", "core_circle", "extended_family", "descendants_guardianship", "trusted_advisors", "public_archive"]
    }
  }
}
