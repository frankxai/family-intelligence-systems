{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-intelligence.systems/schemas/jurisdiction-pack.v1.json",
  "title": "Family Intelligence Jurisdiction Pack",
  "$comment": "JSON Schema cannot compare review dates to current time or resolve citation indexes. Embedded activation fields are non-authoritative; reviewed activation requires server-side @family/security receipt resolution under protocols/trusted-transition-admission/v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "version", "jurisdiction", "status", "effective_from", "review_due", "reviewer", "authorities", "rules", "unsupported_behavior"],
  "properties": {
    "pack_id": { "type": "string", "pattern": "^jurisdiction_[A-Za-z0-9_-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "level"],
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 32 },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "level": { "enum": ["international", "supranational", "country", "state_province", "local", "community"] }
      }
    },
    "status": { "enum": ["research_only", "reviewed", "expired", "withdrawn"] },
    "effective_from": { "type": "string", "format": "date" },
    "review_due": { "type": "string", "format": "date" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": { "enum": ["unassigned", "qualified_human"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "source_type", "checked_at"],
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 240 },
          "url": { "type": "string", "format": "uri", "maxLength": 1000 },
          "source_type": { "enum": ["official_law", "official_archive", "regulator", "standard", "community_authority", "independent_research"] },
          "checked_at": { "type": "string", "format": "date" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "domain", "effect", "summary", "authority_indexes"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^rule_[A-Za-z0-9_-]+$" },
          "domain": { "enum": ["privacy", "civil_records", "children", "special_category_data", "copyright", "portrait_personality", "archive_access", "retention", "export_transfer", "publication", "succession", "community_authority"] },
          "effect": { "enum": ["allow_with_review", "require_consent", "require_qualified_review", "restrict", "block", "informational"] },
          "summary": { "type": "string", "minLength": 5, "maxLength": 1200 },
          "authority_indexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
          "parameters": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
        }
      }
    },
    "runtime_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "evaluated_at", "reviewer_identity_verified", "review_window_current", "authority_references_valid", "controlling_authority_present", "conflicts_resolved"],
      "properties": {
        "receipt_ref": { "type": "string", "pattern": "^runtime_validation_[A-Za-z0-9_-]+$" },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "reviewer_identity_verified": { "const": true },
        "review_window_current": { "const": true },
        "authority_references_valid": { "const": true },
        "controlling_authority_present": { "const": true },
        "conflicts_resolved": { "const": true }
      }
    },
    "supersedes": { "type": "string", "pattern": "^jurisdiction_[A-Za-z0-9_-]+$" },
    "unsupported_behavior": { "const": "block_pending_review" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "reviewed" } }, "required": ["status"] },
      "then": {
        "required": ["runtime_activation"],
        "properties": {
          "reviewer": {
            "properties": {
              "type": { "const": "qualified_human" },
              "reference": { "pattern": "^human_[A-Za-z0-9_-]+$" }
            }
          },
          "authorities": {
            "contains": {
              "properties": {
                "source_type": { "enum": ["official_law", "official_archive", "regulator", "standard", "community_authority"] }
              },
              "required": ["source_type"]
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
